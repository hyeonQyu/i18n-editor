{
  "name": "i18n-editor",
  "version": "3.0.0",
  "main": "dist/electron/electron/main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyeonQyu/i18n-editor"
  },
  "author": "hyeonQyu",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://www.opensource.org/licenses/MIT"
    }
  ],
  "keywords": [
    "i18n",
    "translation",
    "globalization",
    "international",
    "internationalization"
  ],
  "bugs": {
    "url": "https://github.com/hyeonQyu/i18n-editor/issues"
  },
  "homepage": "https://github.com/hyeonQyu/i18n-editor",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "postinstall": "node scripts/setup.cjs",
    "dev:renderer": "vite",
    "dev:electron": "yarn build:electron && NODE_ENV=development electron .",
    "dev": "concurrently \"yarn dev:renderer\" \"wait-on http://localhost:3000 && yarn dev:electron\"",
    "build:renderer": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && node scripts/fix-imports.js",
    "build": "yarn build:renderer && yarn build:electron",
    "type:renderer": "tsc --noEmit",
    "type:electron": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "type": "yarn type:renderer && yarn type:electron",
    "start": "electron .",
    "preview": "vite preview",
    "package:mac": "yarn build && electron-builder --mac",
    "package:win": "yarn build && electron-builder --win",
    "package:linux": "yarn build && electron-builder --linux",
    "package": "yarn build && electron-builder",
    "package:dev": "yarn build && electron-builder --dir"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^22.10.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "glob": "^11.0.3",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "productName": "i18n Editor",
    "appId": "io.github.hyeonQyu.i18n-editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "shared/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterAllArtifactBuild": "scripts/organize-build.cjs"
  }
}
