{
  "name": "i18n-editor",
  "version": "1.1.3",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "client": "yarn workspace i18n-eidtor-client",
    "server": "yarn workspace i18n-editor-server",
    "common": "yarn workspace i18n-editor-common",
    "build": "yarn common build && yarn client build && yarn server build && node setupPackage.js",
    "publish:dist": "yarn --cwd dist publish",
    "build-publish": "yarn build && yarn publish:dist"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "i18n-editor-common": "0.1.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.13",
    "@types/node": "^18.11.17",
    "path": "^0.12.7",
    "prettier": "^2.8.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "typescript": "^4.9.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyeonQyu/i18n-editor"
  },
  "author": "hyeonQyu",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://www.opensource.org/licenses/MIT"
    }
  ],
  "keywords": [
    "i18n",
    "translation",
    "globalization",
    "international",
    "internationalization"
  ],
  "bugs": {
    "url": "https://github.com/hyeonQyu/i18n-editor/issues"
  },
  "homepage": "https://github.com/hyeonQyu/i18n-editor"
}
