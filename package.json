{
  "name": "i18n-editor",
  "version": "3.0.0",
  "main": "dist/electron/main.js",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyeonQyu/i18n-editor"
  },
  "author": "hyeonQyu",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://www.opensource.org/licenses/MIT"
    }
  ],
  "keywords": [
    "i18n",
    "translation",
    "globalization",
    "international",
    "internationalization"
  ],
  "bugs": {
    "url": "https://github.com/hyeonQyu/i18n-editor/issues"
  },
  "homepage": "https://github.com/hyeonQyu/i18n-editor",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "list": "echo '{}' || yarn info --all --json",
    "copy-build": "node scripts/copy-dist-for-package.js",
    "dev:shared": "yarn workspace @i18n-editor/shared dev",
    "dev:renderer": "yarn workspace @i18n-editor/renderer dev",
    "dev:electron": "yarn workspace @i18n-editor/electron dev",
    "dev": "concurrently \"yarn dev:shared\" \"yarn dev:renderer\" \"wait-on http://localhost:4848 && yarn dev:electron\"",
    "build:shared": "yarn workspace @i18n-editor/shared build",
    "build:renderer": "yarn workspace @i18n-editor/renderer build",
    "build:electron": "yarn workspace @i18n-editor/electron build",
    "build": "yarn build:shared && yarn build:renderer && yarn build:electron",
    "type:shared": "yarn workspace @i18n-editor/shared type-check",
    "type:renderer": "yarn workspace @i18n-editor/renderer type-check",
    "type:electron": "yarn workspace @i18n-editor/electron type-check",
    "type": "yarn type:shared && yarn type:renderer && yarn type:electron",
    "start": "electron dist/electron/main.js",
    "preview": "yarn workspace @i18n-editor/renderer preview",
    "package:mac": "yarn build && electron-builder --mac",
    "package:win": "yarn build && electron-builder --win",
    "package:linux": "yarn build && electron-builder --linux",
    "package": "yarn build && electron-builder",
    "package:dev": "yarn build && electron-builder --dir"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.24.2",
    "glob": "^11.0.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "productName": "i18n Editor",
    "appId": "io.github.hyeonQyu.i18n-editor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "icon": "build/icon",
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterAllArtifactBuild": "scripts/organize-build.cjs"
  }
}
